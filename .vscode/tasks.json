{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Docker Image",
            "type": "process",
            "command": "docker",
            "args": [
                "build",
                "-t",
                "masters-latex",
                "."
            ],
            "problemMatcher": []
        },
        {
            "label": "Compile LaTeX",
            "type": "process",
            "dependsOn": "Build Docker Image",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-v",
                "${workspaceFolder}:/workspace",
                "-w",
                "/workspace",
                "masters-latex",
                "sh",
                "-c",
                "sed -i 's/\\r$//' compile.sh && sh ./compile.sh"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Compile LaTeX (Sepoc)",
            "type": "process",
            "dependsOn": "Build Docker Image",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-v",
                "${workspaceFolder}:/workspace",
                "-w",
                "/workspace",
                "masters-latex",
                "sh",
                "-c",
                "sed -i 's/\\r$//' compile_sepoc.sh && sh ./compile_sepoc.sh"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}